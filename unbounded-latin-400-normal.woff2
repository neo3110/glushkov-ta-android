name: Сборка APK

# Запускается вручную (вкладка Actions → «Сборка APK» → Run workflow)
# и автоматически на каждый тег вида v1.0, v1.1 и т.д.
on:
  workflow_dispatch:
  push:
    tags:
      - 'v*'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Забрать код
        uses: actions/checkout@v4

      - name: Поставить JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Поставить Android SDK
        uses: android-actions/setup-android@v3

      - name: Поставить Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      # Ключ подписи лежит в секретах репозитория (Settings → Secrets and
      # variables → Actions). Нет секретов — соберём неподписанный APK,
      # его можно поставить на свой телефон, но в RuStore он не пройдёт.
      - name: Достать ключ подписи
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "::warning::Секрет KEYSTORE_BASE64 не задан — APK будет неподписанным."
            exit 0
          fi
          echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          cat > keystore.properties <<PROPS
          storeFile=$RUNNER_TEMP/release.jks
          storePassword=$KEYSTORE_PASSWORD
          keyAlias=$KEY_ALIAS
          keyPassword=$KEY_PASSWORD
          PROPS

      - name: Собрать APK
        run: |
          if [ -f keystore.properties ]; then
            gradle assembleRelease --no-daemon --stacktrace
          else
            echo "::warning::Ключа нет — собираю отладочную версию. На телефон встанет, в RuStore не пойдёт."
            gradle assembleDebug --no-daemon --stacktrace
          fi

      - name: Убрать ключ с раннера
        if: always()
        run: rm -f keystore.properties "$RUNNER_TEMP/release.jks"

      - name: Показать, что собралось
        run: find app/build/outputs/apk -name '*.apk' -exec ls -lh {} +

      - name: Выложить APK артефактом
        uses: actions/upload-artifact@v4
        with:
          name: glushkov-ta-apk
          path: app/build/outputs/apk/**/*.apk
          retention-days: 30
          if-no-files-found: error
